# Required — the models and web search
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
SERPER_API_KEY=your_serper_api_key

# SEC EDGAR needs no key or account — just a User-Agent identifying you (SEC fair-access policy).
SEC_USER_AGENT=your-name your-email@example.com

# Optional — LangSmith tracing. Set these and every agent run shows up as a nested trace.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=equity-research-agent
